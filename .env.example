# JetKVM WireGuard Installation Configuration
# Copy this file to .env and customize for your setup

# JetKVM Device Settings
JETKVM_IP=192.168.1.100
JETKVM_USER=root
JETKVM_SSH_PORT=22

# WireGuard Interface Settings
WIREGUARD_INTERFACE=wg0
WIREGUARD_IP=192.168.2.1/24

# Path to your WireGuard configuration file
# This should be a valid WireGuard config WITHOUT the Interface.Address line
# (wg command doesn't support it - only wg-quick does, which isn't available)
# See examples/ directory for templates
WIREGUARD_CONFIG=./examples/wg0-server.conf

# Container Runtime (podman or docker)
# Leave empty for auto-detection (prefers podman)
CONTAINER_RUNTIME=

# Build Settings
# Set to "yes" to force rebuild even if wg binary exists
FORCE_BUILD=no

# Boot Persistence
# Delay in seconds before starting WireGuard (to wait for network)
BOOT_DELAY=30

# Connection Watchdog
# Checks if the WireGuard connection is alive and reconnects if broken.
# Requires PersistentKeepalive to be set in your WireGuard peer config.
# How often (in seconds) the watchdog checks the connection
WATCHDOG_INTERVAL=60
# Maximum age (in seconds) of the latest handshake before restarting the interface
WATCHDOG_HANDSHAKE_TIMEOUT=180
